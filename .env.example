# ============================================================
# 163 邮箱 IMAP
# ============================================================

# 163 网页邮箱中开启 IMAP/SMTP 后，使用“客户端授权码”，不是邮箱登录密码。
EMAIL_IMAP_HOST=imap.163.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.163.com
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=your_name@163.com
EMAIL_PASSWORD=请填写163客户端授权码
EMAIL_FOLDER=INBOX

# 简历成功写入飞书后自动发送报名回信
REPLY_ENABLED=true

# 简历程序每轮结束后的等待秒数；作业使用 HOMEWORK_POLL_INTERVAL_SECONDS。
POLL_INTERVAL_SECONDS=60
# 两个程序均完整遍历各自范围内的UID，此项只控制批次大小；简历每批缓存N封正文。
EMAIL_PAGE_SIZE=50
# 简历首次识别邮箱作用域时，默认跳过全部现有邮件；旧库请先执行 --adopt-legacy-state。
PROCESS_EXISTING_ON_FIRST_RUN=false
STATE_DB_PATH=resume_pipeline.db

# ============================================================
# 本地文档解析
# ============================================================

MIN_EXTRACTED_CHARS=80

# auto / libreoffice / antiword / word
DOC_BACKEND=auto

# 一般留空，脚本会自动寻找
LIBREOFFICE_PATH=
ANTIWORD_PATH=

# Windows 如果自动找不到 LibreOffice，可填：
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Linux 也可以显式：
# LIBREOFFICE_PATH=/usr/bin/libreoffice

# ============================================================
# SiliconFlow
# ============================================================

SILICONFLOW_API_KEY=请填写新的key
SILICONFLOW_MODEL=Pro/zai-org/GLM-5.1
# 模板使用2500；未配置此变量时，代码默认3500。
SILICONFLOW_MAX_TOKENS=2500
# true表示发送 enable_thinking=false（关闭思考）；false表示不发送该参数。
SILICONFLOW_SEND_ENABLE_THINKING=true
MAX_RESUME_CHARS=60000

# ============================================================
# 飞书
# ============================================================

FEISHU_APP_ID=cli_xxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
FEISHU_BITABLE_APP_TOKEN=bascnxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxx

# 收件时间如果是飞书日期字段：timestamp
# 如果还是多行文本字段：text
RECEIVED_TIME_MODE=timestamp

FIELD_RECEIVED_TIME=收件时间
FIELD_SENDER=邮件发件人
FIELD_SUBJECT=邮件标题
FIELD_ATTACHMENT=原始简历
# 简历写入姓名；作业邮箱未匹配时，也用此列从主题/附件文件名匹配唯一候选人。
FIELD_NAME=姓名
FIELD_QQ=QQ号
FIELD_INTENTION_GROUP=意向组别
# 飞书多选字段中应预先建立这些选项；其他识别结果会归为“未定义”。
INTENTION_GROUP_OPTIONS=导航,自瞄,机械,软件,硬件,运宣,电控
INTENTION_GROUP_UNKNOWN=未定义
FIELD_COLLEGE=学院
# 仅供历史候选人字段回填在原件不可用时读取已有专业列，不自动建列或写入。
FIELD_MAJOR=专业
FIELD_BIRTHPLACE=生源地
FIELD_STUDENT_ID=学号
FIELD_GENDER=性别
FIELD_SKILLS=技术栈
# 技术栈字段不存在时自动创建；识别到新技能时自动追加多选选项。
AUTO_CREATE_SKILLS_FIELD=true
AUTO_ADD_SKILL_OPTIONS=true
AUTO_CREATE_SHORT_TEXT_FIELDS=true
FIELD_PROJECTS=项目经历
FIELD_APPLICATION_REASON=报名原因
FIELD_HOBBIES=兴趣爱好
FIELD_SUMMARY=简历摘要
FIELD_STATUS=招聘状态
DEFAULT_STATUS=待初筛

# 白名单项：自动记录值得注意的正向特点，字段不存在时自动创建。
FIELD_WHITELIST=白名单项
WHITELIST_ENABLED=true
WHITELIST_RULES="只根据简历中明确出现的事实提取以下正向特点：生源地明确为上海，输出‘上海生源’；兴趣爱好明确包含骑车，输出‘爱好：骑车’；兴趣爱好明确包含战雷，输出‘爱好：战雷’；明确看过比赛，输出‘看过比赛’，如果明确去线下或现场观看，输出‘线下看过比赛’。没有明确证据时不要输出，不得根据学校、专业、项目或常识推断。"

# 历史保留参数：当前两个主脚本不读取以下7项，配置后不会创建或写入相应列。
# 其中 FIELD_EMAIL 不是作业匹配字段；作业匹配请设置 FIELD_SENDER。
FIELD_PHONE=手机号
FIELD_EMAIL=邮箱
FIELD_SCHOOL=学校
FIELD_DEGREE=学历
FIELD_GRADUATION=毕业时间
FIELD_POSITION=应聘岗位
FIELD_EXPERIENCE=工作经历

# INFO保留过滤/失败提示；ERROR会隐藏WARNING级别的过滤日志。
LOG_LEVEL=INFO

# ============================================================
# 作业附件收取（homework_pipeline.py）
# ============================================================
# 周次优先使用邮件主题，其次为各附件文件名；不明确时按北京时间的服务器收件时间兜底。
# 时间兜底仍以每周二00:00为分界；起始日期之前的邮件不收取。
# 此项仍是收件起始日；9月21日并入第1周，第2周从9月29日开始。
HOMEWORK_START_DATE=2026-09-21
# 启动时确保至少6列存在；第7周起按邮件所属周自动扩展。
HOMEWORK_INITIAL_WEEKS=6
# 与简历脚本的 PROCESS_EXISTING_ON_FIRST_RUN 独立，默认补收起始日期以来邮件。
HOMEWORK_PROCESS_EXISTING_ON_FIRST_RUN=true
HOMEWORK_STATE_DB_PATH=homework_pipeline.db
# 作业脚本每轮检查完成后等待15分钟，独立于简历脚本的轮询间隔。
HOMEWORK_POLL_INTERVAL_SECONDS=900
# 无法匹配或入库失败的邮件只转发、不再尝试入库，复用 EMAIL_SMTP_* 和邮箱账号/授权码。
HOMEWORK_UNMATCHED_FORWARD_TO=3464144391@qq.com
