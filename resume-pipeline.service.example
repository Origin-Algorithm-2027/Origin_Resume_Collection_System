[Unit]
Description=Resume Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/resume-pipeline
ExecStart=/opt/resume-pipeline/.venv/bin/python /opt/resume-pipeline/resume_pipeline.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
