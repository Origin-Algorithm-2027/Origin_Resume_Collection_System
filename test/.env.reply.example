# 只给 test/reply_service.py 使用，不需要填写 SiliconFlow 或飞书配置。
EMAIL_IMAP_HOST=imap.163.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.163.com
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=your_name@163.com
EMAIL_PASSWORD=请填写163客户端授权码
EMAIL_FOLDER=INBOX

# 服务启动后只回复新邮件，避免首次运行回复历史邮件。
REPLY_PROCESS_EXISTING_ON_FIRST_RUN=false
REPLY_POLL_INTERVAL_SECONDS=30
REPLY_STATE_PATH=test/reply_state.json
